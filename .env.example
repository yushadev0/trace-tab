# Gmail "Web application" OAuth client — src/background/email/gmail.ts kullanır.
# Google Cloud → APIs & Services → Credentials → Create credentials →
#   OAuth client ID → Application type: Web application
# Yetkili redirect URI (birebir, sondaki / dahil):
#   https://einifdamdgidjbeiodcegakdjfkckmeh.chromiumapp.org/
#
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun. `.env` git'e girmez.

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
